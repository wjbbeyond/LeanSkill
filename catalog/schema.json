{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/wjbbeyond/LeanSkill/main/catalog/schema.json",
  "title": "LeanSkill Catalog",
  "type": "object",
  "required": ["schema_version", "generated_at", "skills", "plugins"],
  "properties": {
    "schema_version": {"const": 1},
    "generated_at": {"type": "string"},
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "invocation", "path", "origin", "status", "implicit_invocation", "capabilities", "trust_tier"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "name": {"type": "string", "minLength": 1},
          "invocation": {"type": "string", "minLength": 1},
          "description": {"type": "string"},
          "path": {"type": "string", "minLength": 1},
          "origin": {"type": "string"},
          "status": {"enum": ["preferred", "available-explicit", "available-implicit", "candidate", "quarantined", "verified", "rejected", "cached-not-enabled", "missing"]},
          "implicit_invocation": {"type": "boolean"},
          "capabilities": {"type": "array", "items": {"type": "string"}},
          "trust_tier": {"type": "string"}
        },
        "additionalProperties": true
      }
    },
    "plugins": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "marketplace", "status"],
        "properties": {
          "name": {"type": "string"},
          "marketplace": {"type": "string"},
          "status": {"enum": ["installed-enabled", "not-installed", "unknown"]},
          "version": {"type": "string"},
          "path": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
